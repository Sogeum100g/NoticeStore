# OAuth client configuration. Never place a confidential backend credential in
# a Flutter asset because desktop/mobile app bundles can be inspected.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=replace-only-if-the-current-desktop-oauth-flow-requires-it
GOOGLE_PROJECT_ID=your-google-cloud-project-id
GOOGLE_WINDOWS_CLIENT_ID=your-windows-client-id.apps.googleusercontent.com

# FastAPI host used by the Flutter client, for example 10.0.2.2:8000.
IP_ADDRESS=localhost:8000
