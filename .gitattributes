# Keep repository text files consistent across Linux, macOS, and Windows.
* text=auto

*.py text eol=lf
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Windows command scripts require CRLF in common toolchains.
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicit binary assets.
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.pdf binary
*.jks binary
*.keystore binary
